# Copiar para .env.local (ignorado pelo git).
# Valores locais: `supabase status` depois de `supabase start`.

# --- Frontend (públicas por natureza: vão para o bundle do browser) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Script de admin (scripts/admin) ---
# SUPABASE_SERVICE_ROLE_KEY NÃO se guarda em ficheiro nenhum do repositório nem
# com prefixo VITE_. Exportar só na shell de quem corre o script, ou usar um
# gestor de segredos.
SUPABASE_URL=http://127.0.0.1:54321
